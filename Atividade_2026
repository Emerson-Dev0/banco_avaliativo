WITH media_categoria AS (
    SELECT
        cd_categoria,
        AVG(nr_estoque) AS media_estoque
    FROM tb_produto
    GROUP BY cd_categoria
)

SELECT
    tb_produto.tx_nome AS produto,
    tb_produto.nr_estoque AS estoque_atual,
    media_categoria.media_estoque,
    media_categoria.media_estoque - tb_produto.nr_estoque AS quantidade_faltante
FROM tb_produto
INNER JOIN media_categoria
    ON media_categoria.cd_categoria = tb_produto.cd_categoria
WHERE tb_produto.nr_estoque < media_categoria.media_estoque;


