WITH receitabruta AS (
    SELECT
        cd_empresa,
        SUM(
            nr_quantidade * vl_unitario
        ) AS receita
    FROM tb_venda
    INNER JOIN tb_item_venda
        ON tb_item_venda.cd_venda = tb_venda.id_venda
    WHERE UPPER(tx_status) = UPPER('PAGO')
    GROUP BY cd_empresa
)

SELECT
    tb_empresa.tx_razao_social,
    receitabruta.receita
FROM tb_empresa
INNER JOIN receitabruta
    ON receitabruta.cd_empresa = tb_empresa.id_empresa
WHERE receitabruta.receita > 10000
ORDER BY receitabruta.receita DESC
LIMIT 3;

