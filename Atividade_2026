WITH gastos AS (
    SELECT
        tb_cliente.id_cliente,
        tb_cliente.tx_nome,
        SUM(
            tb_item_venda.nr_quantidade * tb_item_venda.vl_unitario
        ) AS total_gasto
    FROM tb_cliente
    INNER JOIN tb_venda
        ON tb_venda.cd_cliente = tb_cliente.id_cliente
    INNER JOIN tb_item_venda
        ON tb_item_venda.cd_venda = tb_venda.id_venda
    GROUP BY
        tb_cliente.id_cliente,
        tb_cliente.tx_nome
)

SELECT
    tx_nome,
    total_gasto
    
FROM gastos
WHERE total_gasto > (SELECT AVG(total_gasto) FROM gastos);


