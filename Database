select
    tb_cliente.tx_nome as nomecliente,
    sum(tb_item_venda.nr_quantidade * tb_produto.vl_preco) as valorTotal
from tb_cliente
inner join tb_venda
    on tb_cliente.id_cliente = tb_venda.cd_cliente
inner join tb_item_venda
    on tb_item_venda.id_item_venda = tb_venda.id_venda
inner join tb_produto
    on tb_item_venda.cd_produto = tb_produto.id_produto
group by tb_cliente.tx_nome
order by valorTotal desc;











